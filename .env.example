# Database connection string (PostgreSQL 16 development database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/instapro?schema=public"

# Test database connection string (isolated test database, must target 'instapro_test' on port 5433)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/instapro_test?schema=public"

# Session secret (min 32 characters high-entropy string for HMAC / session signing)
SESSION_SECRET="change-this-to-a-secure-random-secret-at-least-32-chars-long"

# Security Gate: Public registration control
# Must remain false until an unauthenticated abuse-control mechanism (PoW/CAPTCHA) is implemented
ALLOW_PUBLIC_REGISTRATION=false
